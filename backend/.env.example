# NammaPrayana Backend Environment Configuration
# Copy this template to .env for local development.
# In production (Render), configure these keys in Dashboard -> Environment.

# Google Gemini API Keys & Models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite
GEMINI_VISION_MODEL=gemini-2.0-flash

# RailRadar API
RAILRADAR_API_KEY=

# Google Maps Platform
ROUTES_API_KEY=
MAPS_JS_API_KEY=

# Authentication Session Secret (generate a strong random string)
SESSION_SECRET=

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secondary Weather Provider: WeatherAPI.com
# Open-Meteo is primary (free, no key). When Open-Meteo returns HTTP 429 rate limit,
# NammaPrayana automatically falls back to WeatherAPI.com.
# Obtain a free API key at https://www.weatherapi.com/
# Add this environment variable manually in Render Dashboard -> Environment.
WEATHERAPI_KEY=

# Kannada Text-to-Speech (Namma Sahayak Phrase Audio)
# Built-in zero-config Google Translate TTS is active by default (no key required).
# Optional: To use Google Cloud Text-to-Speech API with neural Kannada voices,
# provide an API key with Cloud Text-to-Speech API enabled:
GOOGLE_TTS_API_KEY=

# Environment and Frontend Origin
ENVIRONMENT=production
FRONTEND_URL=https://nammaprayana.vercel.app
