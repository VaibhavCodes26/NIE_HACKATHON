# =============================================================================
# NammaPrayana Backend Configuration Template
# Copy this file to backend/.env and replace placeholders with real credentials.
# NEVER commit backend/.env to version control.
# =============================================================================

# Operational Environment: "development" | "production" | "staging"
ENVIRONMENT=development

# Database Connection String
# For local development (default): leave blank or use sqlite:///./app/nammaprayana.db
# For production (PostgreSQL): postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Production CORS: Comma-separated list of allowed frontend origins
# In production, set to your deployed frontend domain(s)
ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.vercel.app

# API Documentation: set to "false" in production to disable /docs, /redoc, and /openapi.json
ENABLE_API_DOCS=true

# Google Gemini AI credentials (required for Itinerary generation and Namma Drishti OCR)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_VISION_MODEL=gemini-3.8-flash

# Google Maps Platform (Routes API for multi-modal transport routing)
ROUTES_API_KEY=your_google_routes_api_key_here
MAPS_JS_API_KEY=your_google_maps_js_api_key_here

# RailRadar API (Indian Railways real-time train, seat and fare data)
RAILRADAR_API_KEY=your_railradar_api_key_here

# Google OAuth 2.0 Credentials (for "Continue with Google" sign-in)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# Rate limits & Operational Tuning
DRISHTI_MAX_PER_HOUR=60
