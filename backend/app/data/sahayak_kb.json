  "tips": [
    {
      "id": "tip_shop_1",
      "scenario": "shopping",
      "en": "For auto rickshaws, ask them to use the meter ('meter haaki') or agree on a fixed price before getting in. During peak hours or rain, 1.5x meter rate is common."
    },
    {
      "id": "tip_temple_1",
      "scenario": "temple",
      "en": "Always remove shoes before entering temple premises. Dress modestly covering shoulders and knees. Photography is often prohibited in the inner sanctum."
    },
    {
      "id": "tip_food_1",
      "scenario": "food",
      "en": "Traditional South Indian meals are served on banana leaves or steel thalis. Filter coffee is traditionally served in a dabarah and tumbler."
    },
    {
      "id": "tip_emg_112",
      "scenario": "emergency",
      "en": "India's national emergency number is 112 (police, ambulance, fire). Keep it ready, and share your live location with a trusted contact when travelling alone."
    },
    {
      "id": "tip_emg_2",
      "scenario": "emergency",
      "en": "If someone keeps bothering you in a crowd, move towards a shop or a group of families and say it loudly. Locals usually step in to help."
    },
    {
      "id": "tip_tr_1",
      "scenario": "transport",
      "en": "Many bus destination boards are only in Kannada. Confirm the destination with the conductor before boarding."
    },
    {
      "id": "tip_tr_2",
      "scenario": "transport",
      "en": "Karnataka's Shakti scheme gives eligible women free travel on ordinary state-run buses. Carry a valid photo ID and check current rules at the counter."
    },
    {
      "id": "tip_tr_3",
      "scenario": "transport",
      "en": "Book long-distance buses and trains ahead for weekends and festivals. Overnight buses are common between Bengaluru and the coast or north Karnataka."
    },
    {
      "id": "tip_stay_1",
      "scenario": "stay",
      "en": "Ask to see the room before paying, confirm whether the quoted price includes taxes, and ask the check-out time. Hotels will ask for photo ID by law."
    },
    {
      "id": "tip_stay_2",
      "scenario": "stay",
      "en": "In peak season and festivals (Dasara, Hampi Utsav) prices rise sharply. Book early and confirm the booking by phone."
    },
    {
      "id": "tip_out_1",
      "scenario": "outdoor",
      "en": "Start treks and sightseeing early in hot places like Hampi. Carry water, a hat, and sturdy footwear."
    },
    {
      "id": "tip_out_2",
      "scenario": "outdoor",
      "en": "In monsoon, trails and rocks get slippery and some waterfalls are unsafe. Follow local guides and forest-department rules; some treks need prior permission."
    },
    {
      "id": "tip_num_1",
      "scenario": "numbers",
      "en": "Saying the price in Kannada numbers while bargaining shows you know the local rate and often helps you get a fairer price."
    },
    {
      "id": "tip_dir_1",
      "scenario": "directions",
      "en": "Ask two different people before trusting directions. Locals often answer 'it's just there' even for long distances, so ask for time or kilometres."
    },
    {
      "id": "tip_gen_2",
      "scenario": "general",
      "en": "To get someone's attention politely, start with 'ree' or 'sir/madam', then ask your question slowly. Smiling goes a long way."
    },
    {
      "id": "tip_food_3",
      "scenario": "food",
      "en": "Small eateries and stalls increasingly accept UPI, but keep some cash for tea stalls and street vendors."
    }
  ]
}