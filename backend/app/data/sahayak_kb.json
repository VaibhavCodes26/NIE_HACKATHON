  ],
  "tips": [
    {
      "id": "tip_auto_1",
      "scenario": "auto",
      "en": "Ask for the meter first. In Bengaluru many autos refuse it, so agree on a price BEFORE you sit. Never negotiate after the ride starts.",
      "title": "Auto: ask for the meter"
    },
    {
      "id": "tip_auto_2",
      "scenario": "auto",
      "en": "Walking away politely is the strongest bargaining move. Say 'beda, dhanyavaada' and start walking; the price often drops. Check the fair fare in the app's route planner first.",
      "title": "Auto: walk-away trick"
    },
    {
      "id": "tip_auto_3",
      "scenario": "auto",
      "en": "Keep small change ready. Drivers often claim they have no change for large notes.",
      "title": "Auto: keep change"
    },
    {
      "id": "tip_auto_4",
      "scenario": "auto",
      "en": "Tourist spots and railway/bus stations usually have higher quoted prices. Walking a few streets away or using an app-booked ride is often cheaper.",
      "title": "Auto: tourist-spot prices"
    },
    {
      "id": "tip_food_1",
      "scenario": "food",
      "en": "In Karnataka, 'meals' usually means an unlimited thali, and darshini outlets are quick standing-eat places with cheap, good breakfast.",
      "title": "Food: meals and darshini"
    },
    {
      "id": "tip_food_2",
      "scenario": "food",
      "en": "Many Udupi-style restaurants are pure vegetarian. If you eat non-veg, ask 'non-veg ideyaa?' before sitting.",
      "title": "Food: pure-veg places"
    },
    {
      "id": "tip_temple_1",
      "scenario": "temple",
      "en": "Dress modestly at temples: shoulders and knees covered. Footwear is left outside. Some temples ask men to remove shirts in the sanctum and allow only traditional wear.",
      "title": "Temple: dress code"
    },
    {
      "id": "tip_temple_2",
      "scenario": "temple",
      "en": "Photography is often banned inside the sanctum. Ask first, and never photograph priests or worshippers without permission.",
      "title": "Temple: photography"
    },
    {
      "id": "tip_shop_1",
      "scenario": "shopping",
      "en": "For gold or silver jewellery, insist on a hallmarked piece and a proper itemised bill showing weight, rate and making charges.",
      "title": "Jewellery: hallmark and bill"
    },
    {
      "id": "tip_shop_2",
      "scenario": "shopping",
      "en": "Mysore silk and sandalwood are widely imitated. Prefer government-run outlets such as KSIC or Cauvery Emporium for authenticity and fixed prices.",
      "title": "Silk and sandalwood"
    },
    {
      "id": "tip_shop_3",
      "scenario": "shopping",
      "en": "Bargaining is normal at street markets and small shops but not in fixed-price stores or government emporiums. Start around half the first quote and settle near 60-70%.",
      "title": "Bargaining at markets"
    },
    {
      "id": "tip_general_1",
      "scenario": "general",
      "en": "A smile and a few Kannada words like 'namaskara' and 'dhanyavaadagalu' change the mood of almost any interaction. In tourist areas many people also understand Hindi or English.",
      "title": "Basics: friendly Kannada"
    },
    {
      "id": "tip_emg_112",
      "scenario": "emergency",
      "en": "India's national emergency number is 112 (police, ambulance, fire). Keep it ready, and share your live location with a trusted contact when travelling alone.",
      "title": "Emergency: dial 112"
    },
    {
      "id": "tip_emg_2",
      "scenario": "emergency",
      "en": "If someone keeps bothering you in a crowd, move towards a shop or a group of families and say it loudly. Locals usually step in to help.",
      "title": "Safety in crowds"
    },
    {
      "id": "tip_tr_1",
      "scenario": "transport",
      "en": "Many bus destination boards are only in Kannada. Confirm the destination with the conductor before boarding.",
      "title": "Bus boards in Kannada"
    },
    {
      "id": "tip_tr_2",
      "scenario": "transport",
      "en": "Karnataka's Shakti scheme gives eligible women free travel on ordinary state-run buses. Carry a valid photo ID and check current rules at the counter.",
      "title": "Shakti scheme"
    },
    {
      "id": "tip_tr_3",
      "scenario": "transport",
      "en": "Book long-distance buses and trains ahead for weekends and festivals. Overnight buses are common between Bengaluru and the coast or north Karnataka.",
      "title": "Book ahead"
    },
    {
      "id": "tip_stay_1",
      "scenario": "stay",
      "en": "Ask to see the room before paying, confirm whether the quoted price includes taxes, and ask the check-out time. Hotels will ask for photo ID by law.",
      "title": "Stay: check before paying"
    },
    {
      "id": "tip_stay_2",
      "scenario": "stay",
      "en": "In peak season and festivals (Dasara, Hampi Utsav) prices rise sharply. Book early and confirm the booking by phone.",
      "title": "Stay: peak season"
    },
    {
      "id": "tip_out_1",
      "scenario": "outdoor",
      "en": "Start treks and sightseeing early in hot places like Hampi. Carry water, a hat, and sturdy footwear.",
      "title": "Outdoors: start early"
    },
    {
      "id": "tip_out_2",
      "scenario": "outdoor",
      "en": "In monsoon, trails and rocks get slippery and some waterfalls are unsafe. Follow local guides and forest-department rules; some treks need prior permission.",
      "title": "Monsoon trails"
    },
    {
      "id": "tip_num_1",
      "scenario": "numbers",
      "en": "Saying the price in Kannada numbers while bargaining shows you know the local rate and often helps you get a fairer price.",
      "title": "Say prices in Kannada"
    },
    {
      "id": "tip_dir_1",
      "scenario": "directions",
      "en": "Ask two different people before trusting directions. Locals often answer 'it's just there' even for long distances, so ask for time or kilometres.",
      "title": "Directions: ask twice"
    },
    {
      "id": "tip_gen_2",
      "scenario": "general",
      "en": "To get someone's attention politely, start with 'ree' or 'sir/madam', then ask your question slowly. Smiling goes a long way.",
      "title": "Polite address"
    },
    {
      "id": "tip_food_3",
      "scenario": "food",
      "en": "Small eateries and stalls increasingly accept UPI, but keep some cash for tea stalls and street vendors.",
      "title": "Food: UPI and cash"
    },
    {
      "id": "tip_hampi_1",
      "scenario": "outdoor",
      "city": "hampi",
      "title": "Hampi: beat the heat",
      "en": "Hampi is very hot and exposed at midday. Visit monuments early morning or late afternoon, carry water and a hat, and wear footwear that is easy to remove, since stone floors get hot and temples need footwear off."
    },
    {
      "id": "tip_hampi_2",
      "scenario": "auto",
      "city": "hampi",
      "title": "Hampi: getting around",
      "en": "Sights in Hampi are spread out. Locals rent bicycles and two-wheelers, and autos are common. Agree the price (or the meter) before you start, and ask the driver which stops are included."
    },
    {
      "id": "tip_hampi_3",
      "scenario": "temple",
      "city": "hampi",
      "title": "Hampi: temples and tickets",
      "en": "Virupaksha Temple is an active temple, so dress modestly and leave footwear outside. Major monuments such as the Vittala Temple complex are ticketed; check current ticket and timing rules at the counter."
    },
    {
      "id": "tip_hampi_4",
      "scenario": "outdoor",
      "city": "hampi",
      "title": "Hampi: river crossings",
      "en": "Boats and coracles cross the Tungabhadra river. Ask about safety and agree the price before boarding, and avoid crossings when the water is high or the boatman seems unsure."
    },
    {
      "id": "tip_hampi_5",
      "scenario": "stay",
      "city": "hampi",
      "title": "Hampi: where to stay",
      "en": "Stays near Hampi Bazaar are convenient for sunrise visits, while the other side of the river is a quieter cafe-and-guesthouse area. Confirm how you will reach your stay after dark."
    },
    {
      "id": "tip_gokarna_1",
      "scenario": "temple",
      "city": "gokarna",
      "title": "Gokarna: Mahabaleshwara temple",
      "en": "Gokarna's Mahabaleshwara temple is an active pilgrimage site in the town. Dress modestly, follow the temple staff's instructions, and ask before taking photos."
    },
    {
      "id": "tip_gokarna_2",
      "scenario": "outdoor",
      "city": "gokarna",
      "title": "Gokarna: beach hopping",
      "en": "Kudle and Om beach are easy to reach. Other beaches such as Half Moon and Paradise are reached by boat or a coastal trek, which can be steep and uneven, so wear proper shoes and carry water."
    },
    {
      "id": "tip_gokarna_3",
      "scenario": "outdoor",
      "city": "gokarna",
      "title": "Gokarna: swimming safety",
      "en": "Sea currents can be strong, especially in monsoon. Follow lifeguard and local warnings, avoid swimming alone or after dark, and note that many beach shacks close during the rains."
    },
    {
      "id": "tip_gokarna_4",
      "scenario": "food",
      "city": "gokarna",
      "title": "Gokarna: beach shack food",
      "en": "Confirm menu prices before ordering at beach shacks. Seafood is common; if you eat vegetarian, say so clearly when ordering."
    },
    {
      "id": "tip_coorg_1",
      "scenario": "transport",
      "city": "coorg",
      "title": "Coorg: ghat roads",
      "en": "Roads around Coorg wind through hills and get misty or slippery in monsoon. Allow extra travel time and avoid driving ghat sections at night."
    },
    {
      "id": "tip_coorg_2",
      "scenario": "stay",
      "city": "coorg",
      "title": "Coorg: plantation homestays",
      "en": "Many people stay in plantation homestays. Mobile signal can be weak, so save the owner's phone number and confirm the pickup point and arrival time in advance."
    },
    {
      "id": "tip_coorg_3",
      "scenario": "food",
      "city": "coorg",
      "title": "Coorg: local food",
      "en": "Kodava cuisine includes pandi curry (pork) and kadambuttu (rice dumplings). Ask what is vegetarian if needed. Coorg coffee and honey are best bought as sealed packs from reputable shops."
    },
    {
      "id": "tip_coorg_4",
      "scenario": "outdoor",
      "city": "coorg",
      "title": "Coorg: treks and forests",
      "en": "Some treks and forest areas need forest department permission. Check ahead, trek with a local guide, and expect leeches and slippery trails in monsoon."
    },
    {
      "id": "tip_mysuru_1",
      "scenario": "temple",
      "city": "mysuru",
      "title": "Mysuru: Palace rules",
      "en": "At Mysuru Palace, footwear is left outside and photography inside the halls is usually restricted. Check the rules at the entrance. The palace is illuminated on certain evenings such as Sundays, public holidays and during Dasara; confirm timings locally."
    },
    {
      "id": "tip_mysuru_2",
      "scenario": "stay",
      "city": "mysuru",
      "title": "Mysuru: Dasara crowds",
      "en": "Dasara (usually September to October) brings big crowds and higher hotel prices. Book stays and transport early."
    },
    {
      "id": "tip_mysuru_3",
      "scenario": "shopping",
      "city": "mysuru",
      "title": "Mysuru: markets and sweets",
      "en": "Devaraja Market is good for flowers, spices and local goods, and bargaining is normal there. Mysore Pak is the famous local sweet. For silk and sandalwood, prefer government emporiums for authenticity."
    },
    {
      "id": "tip_mysuru_4",
      "scenario": "temple",
      "city": "mysuru",
      "title": "Mysuru: Chamundi Hills",
      "en": "Chamundi Hills has a temple at the top, reached by road or by the long stair climb. Go early in the morning when it is cooler, and dress modestly for the temple."
    },
    {
      "id": "tip_belagavi_1",
      "scenario": "general",
      "city": "belagavi",
      "title": "Belagavi: languages",
      "en": "Belagavi is a border city where both Kannada and Marathi are widely spoken, and Hindi works in many places. Marathi speakers can usually manage, but a greeting in Kannada is appreciated."
    },
    {
      "id": "tip_belagavi_2",
      "scenario": "temple",
      "city": "belagavi",
      "title": "Belagavi: fort and Kamal Basadi",
      "en": "Belagavi Fort has the Kamal Basadi, a Jain temple, inside. Dress modestly and check visiting hours locally."
    },
    {
      "id": "tip_belagavi_3",
      "scenario": "food",
      "city": "belagavi",
      "title": "Belagavi: kunda",
      "en": "Kunda is the sweet Belagavi is known for. Buy from busy, well-known sweet shops and check freshness."
    },
    {
      "id": "tip_belagavi_4",
      "scenario": "outdoor",
      "city": "belagavi",
      "title": "Belagavi: waterfalls",
      "en": "Waterfalls near Belagavi, such as Gokak Falls, are best after the monsoon. Rocks are slippery and water levels can rise suddenly, so stay behind safety barriers and follow local warnings."
    },
    {
      "id": "tip_belagavi_5",
      "scenario": "shopping",
      "city": "belagavi",
      "title": "Belagavi: shopping",
      "en": "Khade Bazaar is the traditional market area for local shopping. Bargaining is normal at small shops but not in fixed-price stores."
    }
  ]
}