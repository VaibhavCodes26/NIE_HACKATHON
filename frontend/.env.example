# =============================================================================
# NammaPrayana Frontend Configuration Template
# Copy this file to frontend/.env.local (or set in hosting environment variables).
# Restrict client-side API keys using HTTP referrer restrictions in Google/Geoapify consoles.
# =============================================================================

# Backend API Base URL (omit trailing slash)
# Local: http://localhost:8000 or http://127.0.0.1:8000
# Production: https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:8000

# Google OAuth 2.0 Web Client ID (matches GOOGLE_CLIENT_ID in backend)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Google Maps JavaScript API Key (ensure HTTP Referrer restrictions are enabled in Google Cloud Console)
VITE_MAPS_JS_API_KEY=your_google_maps_javascript_api_key

# Geoapify API Key (used for destination location autocomplete; ensure domain restrictions are enabled)
VITE_GEOAPIFY_API_KEY=your_geoapify_api_key_here
